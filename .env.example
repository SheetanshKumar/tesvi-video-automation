# Copy to .env and adjust for your local setup.
# .env is git-ignored; do NOT commit real secrets.

# ------------------------------------------------------------------- database
DATABASE_URL=postgres://tesvi:tesvi@localhost:5432/tesvi?sslmode=disable

# ------------------------------------------------------------------------ gcp
# Populated once we start deploying services.
# GCP_PROJECT_ID=
# GCS_BUCKET=

# ------------------------------------------------------------------ anthropic
# Populated once the extractor service exists.
# ANTHROPIC_API_KEY=

# ------------------------------------------------------------------- youtube
# Populated once the publisher service exists.
# YOUTUBE_OAUTH_CLIENT_ID=
# YOUTUBE_OAUTH_CLIENT_SECRET=
# YOUTUBE_OAUTH_REFRESH_TOKEN=
